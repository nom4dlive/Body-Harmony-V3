#!/bin/bash
# Pre-commit Hook - Body Harmony Nexus Protocol V3.2
# Executa validações automáticas antes de cada commit
# Fonte da verdade: AGENTS.md + DESIGN.md + openspec/

set -e

echo "🔒 Nexus Gate: Executando validações pré-commit..."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

# 1. Verificar se há arquivos .env ou segredos expostos
echo -e "\n${YELLOW}[1/6] Verificando segredos expostos...${NC}"
if git diff --cached --name-only | grep -E '\.env$|\.env\.' | grep -v '\.example$' > /dev/null 2>&1; then
    echo -e "${RED}❌ ERRO: Arquivos .env detectados no commit!${NC}"
    echo "   Remova os seguintes arquivos:"
    git diff --cached --name-only | grep -E '\.env$|\.env\.' | grep -v '\.example$'
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✅ Nenhum arquivo .env detectado${NC}"
fi

# 2. Verificar se há tokens hardcoded (busca simples)
echo -e "\n${YELLOW}[2/6] Buscando tokens hardcoded...${NC}"
HARDCODED_FILES=$(git diff --cached --name-only | xargs grep -l "AAEP3H5a66EADhKxmeMKuoxgcL_IX92R9To" 2>/dev/null | grep -v -E "(nexus_autofix.py|pre-commit)$" || true)
if [ ! -z "$HARDCODED_FILES" ]; then
    echo -e "${RED}❌ ERRO: Token do Telegram hardcoded detectado!${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✅ Nenhum token hardcoded detectado${NC}"
fi

# 3. Validar contratos JSON (se houver mudanças em openspec/contracts/)
echo -e "\n${YELLOW}[3/6] Validando contratos JSON...${NC}"
CONTRACT_FILES=$(git diff --cached --name-only | grep 'openspec/contracts/.*\.json$' || true)
if [ ! -z "$CONTRACT_FILES" ]; then
    for file in $CONTRACT_FILES; do
        if ! python3 -m json.tool "$file" > /dev/null 2>&1; then
            echo -e "${RED}❌ ERRO: JSON inválido em $file${NC}"
            ERRORS=$((ERRORS + 1))
        fi
    done
    echo -e "${GREEN}✅ Contratos JSON válidos${NC}"
else
    echo -e "${GREEN}✅ Nenhuma mudança em contratos JSON${NC}"
fi

# 4. Verificar migrações SQL (se houver mudanças em infrastructure/database/migrations/)
echo -e "\n${YELLOW}[4/6] Verificando migrações...${NC}"
MIGRATION_FILES=$(git diff --cached --name-only | grep 'infrastructure/database/migrations/.*\.sql$' || true)
if [ ! -z "$MIGRATION_FILES" ]; then
    # Verificar se o nome segue o padrão V###_*.sql
    for file in $MIGRATION_FILES; do
        filename=$(basename "$file")
        if ! [[ "$filename" =~ ^V[0-9]{3}_.*\.sql$ ]]; then
            echo -e "${YELLOW}⚠️  AVISO: Migração $filename não segue padrão V###_*.sql${NC}"
            WARNINGS=$((WARNINGS + 1))
        fi
    done
    echo -e "${GREEN}✅ Migrações verificadas${NC}"
else
    echo -e "${GREEN}✅ Nenhuma mudança em migrações${NC}"
fi

# 5. Verificar se há scripts de debug
echo -e "\n${YELLOW}[5/6] Verificando scripts de debug...${NC}"
DEBUG_FILES=$(git diff --cached --name-only | grep -E 'debug.*\.php$|EMERGENCY.*\.php$' || true)
if [ ! -z "$DEBUG_FILES" ]; then
    echo -e "${RED}❌ ERRO: Scripts de debug detectados no commit!${NC}"
    echo "   Remova os seguintes arquivos:"
    echo "$DEBUG_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✅ Nenhum script de debug detectado${NC}"
fi

# 6. Verificar formatação básica (EditorConfig)
echo -e "\n${YELLOW}[6/6] Verificando formatação (EditorConfig)...${NC}"
# Verifica se há tabs em arquivos que devem usar spaces
TAB_FILES=$(git diff --cached --name-only | grep -E '\.(php|py|js|ts|jsx|tsx|css|scss)$' | xargs grep -l $'\t' 2>/dev/null || true)
if [ ! -z "$TAB_FILES" ]; then
    echo -e "${YELLOW}⚠️  AVISO: Tabs detectados em arquivos que devem usar espaços:${NC}"
    echo "$TAB_FILES"
    echo "   Execute: editorconfig-checker para corrigir automaticamente"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${GREEN}✅ Formatação consistente${NC}"
fi

# Resumo final
echo -e "\n=================================="
echo -e "📊 Resumo das Validações"
echo -e "=================================="
echo -e "Erros: ${RED}$ERRORS${NC}"
echo -e "Avisos: ${YELLOW}$WARNINGS${NC}"

if [ $ERRORS -gt 0 ]; then
    echo -e "\n${RED}🚫 COMMIT BLOQUEADO: Corrija os erros acima antes de prosseguir.${NC}"
    echo -e "Dica: Execute \`python3 scripts/nexus_ai_orchestrator.py analyze\` para mais detalhes."
    exit 1
else
    if [ $WARNINGS -gt 0 ]; then
        echo -e "\n${YELLOW}⚠️  COMMIT PERMITIDO COM AVISOS: Revise os avisos acima.${NC}"
    else
        echo -e "\n${GREEN}✅ TODAS AS VALIDAÇÕES PASSARAM! Commit permitido.${NC}"
    fi
    exit 0
fi
